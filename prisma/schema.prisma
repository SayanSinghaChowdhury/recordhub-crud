// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "sqlite"
}


model UserRecord{
  id String @id @default(uuid())

  fullName String

  email String @unique

  gender String

  phone String @unique 

  address String

}